<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <link rel="icon" href="/simplesaml/assets/base/icons/favicon.ico?tag=542d7">
    <title>Sending message</title>
    <link rel="stylesheet" href="/simplesaml/assets/base/css/postSubmit.css?tag=915f3">
    </head>
<body>
    <h1 id="page-title" class="mb-2 center hidden">Sending message</h1>
    <form method="post" action="https://tm-sg-proxy-auth:8089/v1/sso">
        <input
                type="submit"
                id="postLoginSubmitButton"
                value="Continue"
                class="js-only"
                aria-hidden="true"
                tabindex="-1"
        >
                <input type="hidden" name="SAMLRequest" value="">
                <input type="hidden" name="RelayState" value="https://auth.ztsa-iag.trendmicro.com/doLogin.php?action=saml&amp;authtype=ntlm&amp;cid=2b893c37-2e09-4dec-90ba-dfdbf38eefab&amp;forward=https%3A//cdn.jsdelivr.net/npm/tesseract.js%405.1.1/dist/tesseract.min.js&amp;authId=7356d238-365a-407d-8914-fd9463125549&amp;ts=1791886930&amp;sig=56a148d2ae6aefb0fbaa">
                <input type="hidden" name="companyId" value="2b893c37-2e09-4dec-90ba-dfdbf38eefab">
        <noscript>
                        <style>
              .js-only {
                display: none !important;
              }
            </style>
            <h2>Warning</h2>
            <p>Since your browser does not support Javascript, you must press the button below to proceed.</p>
            <button type="submit">Yes, continue</button>
        </noscript>
    </form>

    <div id="slowPostMessage"
         class="js-only slowPostMessage hidden"
         role="alert"
         aria-live="assertive"
         aria-atomic="true"
         aria-labelledby="slowpost-title"
         aria-describedby="slowpost-desc"
         data-slow-post-delay="30000"
         tabindex="-1">
        <div class="p-2 mt-1">
            <h2 id="slowpost-title" class="mb-2">Connecting to the application…</h2>
            <div id="slowpost-desc">
                <div class="mb-2">
                    The application at https://tm-sg-proxy-auth:8089/v1/sso may not be responding.
                </div>
                <div class="mb-0">
                    Your browser will continue trying to connect. Do not refresh this page or press the back button, as it may cause an error.
                    If you are unable to connect, return to the original application and try again.
                </div>
            </div>
        </div>
    </div>
    <span id="loader" class="loader js-only"></span>

<script src="/simplesaml/assets/base/js/post.js?tag=d5857"></script>
</body>
</html>
